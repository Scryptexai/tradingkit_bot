# Supabase public project URL and publishable key. Publishable keys are intended for the browser;
# NEVER put a Supabase secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY
# Use the stable deployed website URL allowed by Supabase Auth redirect settings.
VITE_AUTH_REDIRECT_URL=https://ai-quant-lab-blush.vercel.app/
