# SQLite research database (local dev)
QUANTLAB_DB=data/quantlab.sqlite3

# Backend MCP client OAuth callback configuration.
# Use the public HTTPS origin where FastAPI is actually reachable; localhost only for local dev.
TRADINGKIT_PUBLIC_BASE_URL=https://your-backend.example.com
TRADINGKIT_FRONTEND_URL=https://your-ui.example.com
TRADINGKIT_FRONTEND_ORIGINS=https://your-ui.example.com

# Supabase Auth session verification for browser-to-backend calls.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this backend-only, stable across restarts, and out of Git/chat.
TRADINGKIT_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Frontend build-time setting, configured in cloud/.env.local or deployment environment:
# VITE_BACKEND_URL=https://your-backend.example.com
